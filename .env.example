# Copy to .env and adjust.
DATABASE_URL="postgresql://nstfair:nstfair@localhost:5434/nstfair?schema=public"

# 32+ random chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Seeded admin account (only used by `npm run db:seed`)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="admin1234"
SEED_ADMIN_NAME="Site Admin"

# Where uploaded media is written (relative to project root)
UPLOAD_DIR="uploads"

# Largest single upload, in megabytes. Note that the request body is buffered in
# memory before it is written to disk, so raising this well past ~200 on a small
# instance risks the process running out of memory — move to presigned uploads
# against object storage before serving really large video.
UPLOAD_MAX_MB="100"

# Any file type is accepted except executables and scripts (see src/lib/file-types.ts).
# Set to "true" only if a deployment genuinely needs to distribute binaries.
UPLOAD_ALLOW_ALL_TYPES="false"

# Public base URL, used for sitemap.xml / canonical tags
NEXT_PUBLIC_SITE_URL="http://localhost:3100"
