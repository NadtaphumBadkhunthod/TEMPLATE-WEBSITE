# Copy to .env and adjust.
DATABASE_URL="postgresql://showcase:showcase@localhost:5433/showcase?schema=public"

# 32+ random chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Seeded admin account (only used by `npm run db:seed`)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="admin1234"
SEED_ADMIN_NAME="Site Admin"

# Where uploaded media is written (relative to project root)
UPLOAD_DIR="uploads"

# Public base URL, used for sitemap.xml / canonical tags
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
