//
//   -- exactly one default locale
//   CREATE UNIQUE INDEX locales_one_default
//     ON locales (is_default) WHERE is_default;
//
//   -- JSONB containment lookups for custom fields
//   CREATE INDEX projects_custom_gin ON projects USING gin (custom jsonb_path_ops);
//   CREATE INDEX project_translations_custom_gin
//     ON project_translations USING gin (custom jsonb_path_ops);
//   CREATE INDEX quote_requests_data_gin
//     ON quote_requests USING gin (data jsonb_path_ops);
//
//   -- full-text search per locale ('thai' config needs a dictionary; start with 'simple')
//   ALTER TABLE project_translations
//     ADD COLUMN search_vector tsvector GENERATED ALWAYS AS (
//       to_tsvector('simple', coalesce(title,'') || ' ' || coalesce(summary,''))
//     ) STORED;
//   CREATE INDEX project_translations_search ON project_translations USING gin (search_vector);
//
//   -- media must have exactly one source
//   ALTER TABLE media_assets ADD CONSTRAINT media_has_source
//     CHECK (num_nonnulls(storage_key, external_url) = 1);
//
//   -- price fields must be present when displayed
//   ALTER TABLE projects ADD CONSTRAINT price_amount_required
//     CHECK (price_display_mode IN ('hidden','on_request') OR price_amount IS NOT NULL);
